{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "oxc",
    "promise",
    "typescript",
    "unicorn",
    "vitest",
    "vue"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "curly": [
      "error",
      "all"
    ],
    "no-restricted-globals": [
      "error",
      {
        "name": "Date",
        "message": "Use Temporal (conventions/code-style.md)."
      }
    ],
    "func-style": [
      "error",
      "declaration"
    ],
    "prefer-arrow-callback": "error",
    "no-nested-ternary": "error"
  }
}
